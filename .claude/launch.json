{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dnd-editor",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{const fs=require('fs'),p=require('path'),f=p.join(process.cwd(),q.url==='/'?'index.html':q.url),e=p.extname(f),t={'.html':'text/html','.js':'application/javascript','.css':'text/css'}[e]||'application/octet-stream';fs.readFile(f,(err,d)=>{if(err){r.writeHead(404);r.end('Not found')}else{r.writeHead(200,{'Content-Type':t});r.end(d)}})}).listen(8765)"],
      "port": 8765
    }
  ]
}